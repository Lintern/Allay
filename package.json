{
  "name": "allay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "commit": "git-cz",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "lint": "eslint .",
    "fmt": "prettier --write . && cd src-tauri && cargo fmt",
    "lint:fix": "eslint . --fix && prettier --write . && cd src-tauri && cargo fmt"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.532",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "commitizen": "^4.3.2",
    "cz-vinyl": "^2.5.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.16",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "lint-staged": {
    "*.{js,ts,vue,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css,html,svg}": "prettier --write",
    "*.rs": [
      "cd src-tauri && cargo fmt --"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-vinyl"
    }
  }
}
